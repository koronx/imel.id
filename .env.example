# Salin menjadi .env lalu sesuaikan sebelum `docker compose up -d`

# ---------------------------------------------------------------- database
DB_NAME=maildb
DB_USER=mailuser
DB_PASSWORD=mailpassword
DB_PORT=5432

# -------------------------------------------------------------------- mail
MAIL_DOMAIN=imel.id
MAIL_HOSTNAME=mail.imel.id
WORKER_COUNT=2

# ------------------------------------------------------------------- ports
WEB_PORT=8080
API_PORT=8000
SMTP_PORT=25
SUBMISSION_PORT=587
IMAP_PORT=143
ADMINER_PORT=8081

# --------------------------------------------------------------------- api
# WAJIB diganti di produksi: dipakai untuk menandatangani token akses
JWT_SECRET=change-me-in-production
JWT_TTL=604800
CORS_ORIGINS=*
APP_DEBUG=false
TZ=Asia/Jakarta

# ------------------------------------------------------------------- relay
# Biarkan false untuk lingkungan lokal: pengiriman antar akun @imel.id tetap jalan,
# email ke domain luar akan mengendap di antrean sampai relay diaktifkan.
RELAY_ENABLED=false
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_TLS=true
