{
    "name": "imel-id/mailserver",
    "description": "imel.id mail server: SMTP submission, inbound SMTP, IMAP and outbound relay",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "workerman/workerman": "^4.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-pcntl": "*",
        "ext-sockets": "*",
        "ext-mbstring": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
